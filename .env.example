# Copia este archivo a .env y ajusta los valores.

# Puerto en el que escucha el servidor
PORT=3000

# OBLIGATORIO en producción. Clave aleatoria de 32+ caracteres para firmar los JWT.
# Generar una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Marca el entorno. En 'production' el servidor NO arranca sin JWT_SECRET.
NODE_ENV=development

# Opcional. Restringe CORS a estos orígenes (separados por coma). Si se omite, CORS queda abierto.
# Ejemplo: CORS_ORIGIN=https://tudominio.com,https://www.tudominio.com
CORS_ORIGIN=
